{
  "name": "@tournament/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Design system i wspólne komponenty. Konsumowany ze źródeł, bez kroku builda.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "//sideEffects": "Bez tego bundler nie usunie nieużywanych komponentów z barrel-a i np. panel admina wciąga zdjęcia z ekranów public.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/index.css",
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "fix-imports": "node scripts/fix-imports.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --build-script-name build-storybook --exit-zero-on-changes"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-table": "^9.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "chromatic": "^18.0.1",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
