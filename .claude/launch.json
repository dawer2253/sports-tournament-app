{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "packages/ui", "run", "storybook", "--", "--no-open", "--quiet"],
      "port": 6006
    },
    {
      "name": "mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mock"],
      "port": 4010
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 5173
    },
    {
      "name": "admin-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_API_URL=http://127.0.0.1:4010&& npm run dev:admin"],
      "port": 5173
    },
    {
      "name": "public",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:public"],
      "port": 5174
    }
  ]
}
