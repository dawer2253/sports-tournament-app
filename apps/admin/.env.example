# Backend. Domyślnie mock kontraktu (npm run mock) — wystarcza do pracy nad
# ekranami, bo endpointy domenowe po stronie Laravela jeszcze nie istnieją.
#
# Przeciw lokalnemu Laravelowi (make up) ustaw:
#   VITE_API_URL=http://localhost:8000/api/v1
# CORS po stronie backendu dopuszcza porty 5173 i 5174, w wariancie localhost
# i 127.0.0.1. Logowanie działa; lista turniejów zwróci 404, dopóki nie powstanie
# GET /tournaments.
VITE_API_URL=http://127.0.0.1:4010

# Strona publiczna (apps/public), bez końcowego ukośnika. Panel składa z niej
# link „Otwórz stronę": {VITE_PUBLIC_URL}/t/{slug}. Bez zmiennej przyjmuje
# lokalny serwer dev strony publicznej.
VITE_PUBLIC_URL=http://localhost:5174
